# Contextual Reader backend configuration.
# Copy to backend/.env for local development, or inject these variables through
# your process manager / container environment in production.
# Never commit a real .env file.

# --- Django core -----------------------------------------------------------
# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Set to True only for local development. Production must keep this False.
DEBUG=False
# Comma-separated public hostnames. No wildcard.
ALLOWED_HOSTS=reader.example.com
# Optional, comma-separated, e.g. https://reader.example.com
CSRF_TRUSTED_ORIGINS=

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins, e.g. https://reader.example.com
CORS_ALLOWED_ORIGINS=
# Keep both False unless you have a specific reason. Never combine a wildcard
# origin with credentials.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=False

# --- Database / storage ----------------------------------------------------
# Optional overrides; defaults live under backend/db_data and backend/media.
SQLITE_PATH=
SQLITE_TIMEOUT=20
MEDIA_ROOT=

# --- Uploads ---------------------------------------------------------------
# Maximum accepted upload size in bytes (default 100 MB).
MAX_FILE_SIZE=104857600
# Comma-separated formats accepted by the upload endpoint.
SUPPORTED_FORMATS=epub,txt,pdf,md,zip
# Request body cap in bytes (default 25 MB).
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
# Files above this size are streamed to disk instead of buffered in RAM.
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440

# --- LLM / OmniRoute -------------------------------------------------------
# Base URL of the OpenAI-compatible endpoint, including /v1.
# Leave empty to disable LLM features and fall back to Google Translate.
OMNIROUTE_BASE_URL=
# Legacy alias, still accepted. Prefer OMNIROUTE_BASE_URL.
OMNIROUTE_URL=
OMNIROUTE_MODEL=auto/best-free
OMNIROUTE_API_KEY=
# Comma-separated hostnames that clients may pass as custom_base_url.
# Empty means "only the host of OMNIROUTE_BASE_URL".
LLM_ALLOWED_HOSTS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
