# Contextual Reader - Environment Variables
# Copy ini ke .env dan isi dengan nilai produksi

# Backend
SECRET_KEY=change-this-to-random-secret-key-in-production
DEBUG=0
ALLOWED_HOSTS=localhost,reader.bagaswibowo.app
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
OMNIROUTE_URL=http://your-omni-route-server:20129/v1
OMNIROUTE_MODEL=auto/best-free

# Database (SQLite - tidak digunakan di production, tapi disiapkan)
# DATABASE_URL=sqlite:///db_data/db.sqlite3

# Media
MAX_FILE_SIZE=104857600  # 100 MB
SUPPORTED_FORMATS=md,zip,txt,epub

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Tunnel
# TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Docker Compose
POSTGRES_USER=contextual
POSTGRES_PASSWORD=contextual
POSTGRES_DB=contextual
