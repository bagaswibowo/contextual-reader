# Contextual Reader - Environment Variables
# Copy ini ke .env dan isi dengan nilai produksi
# JANGAN commit file .env yang berisi nilai nyata

# --- Django Core -------------------------------------------------------------
# Required in production. Generate random SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Set to True only for local development. Production must keep this False.
DEBUG=False

# Comma-separated public hostnames. No wildcard.
# Contoh: reader.bagaswibowo.app, reader.example.com
ALLOWED_HOSTS=

# Optional, comma-separated, e.g. https://reader.bagaswibowo.app
# Gunakan HTTPS di produksi.
CSRF_TRUSTED_ORIGINS=

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins, e.g. https://reader.bagaswibowo.app
# JANGAN gunakan wildcard (*) atau kombinasi dengan credentials.
CORS_ALLOWED_ORIGINS=

# Gunakan False kecuali ada alasan spesifik.
CORS_ALLOW_ALL_ORIGINS=False

# Gunakan False kecuali ada alasan spesifik.
# CORS_ALLOW_CREDENTIALS=False mencegah cookie-based auth yang tidak aman.
CORS_ALLOW_CREDENTIALS=False

# --- Database / Storage -------------------------------------------------------
# SQLite (default): backend/db_data/db.sqlite3
# Postgres (opsional, untuk Sprint 1):
# DATABASE_URL=postgresql://contextal:contextal@localhost:5432/contextal

# SQLite-specific settings
SQLITE_TIMEOUT=20

# Media files
MEDIA_ROOT=

# --- Uploads ---------------------------------------------------------------
# Maximum accepted upload size in bytes (default 100 MB).
MAX_FILE_SIZE=104857600

# Comma-separated formats accepted by the upload endpoint.
SUPPORTED_FORMATS=epub,txt,pdf,md,zip

# Request body cap in bytes (default 25 MB).
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400

# Files above this size are streamed to disk instead of buffered in RAM.
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440

# --- LLM / OmniRoute -------------------------------------------------------
# Base URL of the OpenAI-compatible endpoint, including /v1.
# Kosongkan jika tidak menggunakan LLM (fallback ke Google Translate).
OMNIROUTE_BASE_URL=

# Legacy alias, masih diterima backend.
# Disarankan gunakan OMNIROUTE_BASE_URL saja.
OMNIROUTE_URL=

OMNIROUTE_MODEL=auto/best-free
OMNIROUTE_API_KEY=

# Comma-separated hostnames yang boleh di-pass sebagai custom_base_url.
# Kosong = hanya host dari OMNIROUTE_BASE_URL.
LLM_ALLOWED_HOSTS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Frontend (Nginx) -------------------------------------------------------
# Base URL API frontend (tanpa trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Cloudflare Tunnel -------------------------------------------------------
# Token tunnel. Gunakan file env (TUNNEL_TOKEN_FILE) alih-alih CLI argumen.
# TUNNEL_TOKEN_FILE=/etc/cloudflared/tunnel-token
# TUNNEL_TOKEN= (isi dengan token produksi, atau biarkan kosong untuk development)

# --- Docker Compose ---------------------------------------------------------
# Database untuk Postgres (jika digunakan)
POSTGRES_USER=contextual
POSTGRES_PASSWORD=contextual
POSTGRES_DB=contextual

# --- Optional: Monitoring & Health -------------------------------------------
# Health check interval (backend)
HEALTHCHECK_INTERVAL=30s

# Log rotation size (backend)
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
